<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="show_avatar_on_the_right"
        app:title="@string/settings_show_avatar_on_the_right" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="collapse_account_section"
        app:title="@string/settings_collapse_account_section_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="collapse_reddit_section"
        app:title="@string/settings_collapse_reddit_section_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="collapse_post_section"
        app:title="@string/settings_collapse_post_section_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="collapse_preferences_section"
        app:title="@string/settings_collapse_preferences_section_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="shown"
        app:entries="@array/settings_drawer_section_state"
        app:entryValues="@array/settings_drawer_section_state_values"
        app:key="recent_subreddits_section"
        app:title="@string/settings_drawer_recents_section_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="5"
        app:entries="@array/recent_subreddits_limit"
        app:entryValues="@array/recent_subreddits_limit"
        app:key="recent_subreddits_limit"
        app:title="@string/settings_recent_subreddits_limit_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="shown"
        app:entries="@array/settings_drawer_section_state"
        app:entryValues="@array/settings_drawer_section_state_values"
        app:key="favorite_subreddits_section"
        app:title="@string/settings_drawer_favorites_section_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontListPreference
        app:defaultValue="shown"
        app:entries="@array/settings_drawer_section_state"
        app:entryValues="@array/settings_drawer_section_state_values"
        app:key="subscribed_subreddits_section"
        app:title="@string/settings_drawer_subscribed_section_title"
        app:useSimpleSummaryProvider="true" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="hide_account_karma"
        app:title="@string/settings_navigation_drawer_enable_hide_karma_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreferenceCategory
        app:title="@string/settings_quick_toggles_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="true"
        app:key="show_theme_toggle_in_navigation_drawer"
        app:title="@string/settings_show_theme_toggle_in_navigation_drawer_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="true"
        app:key="show_nsfw_toggle_in_navigation_drawer"
        app:title="@string/settings_show_nsfw_toggle_in_navigation_drawer_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="show_thumbnail_on_the_left_toggle_in_navigation_drawer"
        app:title="@string/settings_show_thumbnail_on_the_left_toggle_in_navigation_drawer_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="show_resume_toggle_in_navigation_drawer"
        app:title="@string/settings_show_resume_toggle_in_navigation_drawer_title" />


</PreferenceScreen>