<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        app:title="@string/settings_acknowledgement_master_title"
        app:fragment="ml.docilealligator.infinityforreddit.settings.AcknowledgementFragment" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        app:title="@string/settings_credits_master_title"
        app:fragment="ml.docilealligator.infinityforreddit.settings.CreditsPreferenceFragment" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="translation"
        app:title="@string/settings_translation_title"
        app:summary="@string/settings_translation_summary"
        app:fragment="ml.docilealligator.infinityforreddit.settings.TranslationFragment"/>

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="open_source"
        app:title="@string/settings_open_source_title"
        app:summary="@string/settings_open_source_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="email"
        app:title="@string/settings_email_title"
        app:summary="@string/settings_email_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="reddit_account"
        app:title="@string/settings_reddit_account_title"
        app:summary="@string/settings_reddit_account_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="subreddit"
        app:title="@string/settings_subreddit_title"
        app:summary="@string/settings_subreddit_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="share"
        app:title="@string/settings_share_title"
        app:summary="@string/settings_share_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="patcheddit"
        app:title="@string/settings_patcheddit_title"
        app:summary="@string/settings_patcheddit_notice" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="true"
        app:key="auto_check_for_updates"
        app:title="@string/settings_auto_check_for_updates_title"
        app:summary="@string/settings_auto_check_for_updates_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontSwitchPreference
        app:defaultValue="false"
        app:key="include_prereleases"
        app:title="@string/settings_include_prereleases_title"
        app:summary="@string/settings_include_prereleases_summary" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="check_for_updates"
        app:title="@string/settings_check_for_updates_title" />

    <ml.docilealligator.infinityforreddit.customviews.preference.CustomFontPreference
        android:key="version"
        app:title="@string/settings_version_title"
        app:summary="@string/settings_version_summary" />


</PreferenceScreen>
