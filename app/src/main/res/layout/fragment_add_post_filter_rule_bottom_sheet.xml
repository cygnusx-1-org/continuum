<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/title_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp"
            android:textSize="?attr/font_default"
            android:textStyle="bold"
            android:textColor="?attr/primaryTextColor"
            android:fontFamily="?attr/font_family" />

        <TextView
            android:id="@+id/polarity_label_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            android:text="@string/post_filter_rule_polarity_label"
            android:textSize="?attr/font_12"
            android:textColor="?attr/secondaryTextColor"
            android:fontFamily="?attr/font_family" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/polarity_chip_group_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/exclude_chip_add_post_filter_rule_bottom_sheet_fragment"
                style="@style/Widget.Continuum.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_filter_rule_exclude"
                android:textSize="?attr/font_default"
                android:fontFamily="?attr/font_family" />

            <com.google.android.material.chip.Chip
                android:id="@+id/include_chip_add_post_filter_rule_bottom_sheet_fragment"
                style="@style/Widget.Continuum.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/post_filter_rule_include"
                android:textSize="?attr/font_default"
                android:fontFamily="?attr/font_family" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/polarity_summary_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            android:textSize="?attr/font_12"
            android:textColor="?attr/secondaryTextColor"
            android:fontFamily="?attr/font_family" />

        <TextView
            android:id="@+id/field_label_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:text="@string/post_filter_rule_field_label"
            android:textSize="?attr/font_12"
            android:textColor="?attr/secondaryTextColor"
            android:fontFamily="?attr/font_family" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/field_chip_group_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <!-- Subreddit rules only: how the term matches a name. Hidden for every other field, which
             has no wildcard forms, so its label and chips move together as one block. -->
        <TextView
            android:id="@+id/match_label_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:text="@string/post_filter_rule_match_label"
            android:textSize="?attr/font_12"
            android:textColor="?attr/secondaryTextColor"
            android:fontFamily="?attr/font_family" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/match_chip_group_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <TextView
            android:id="@+id/match_summary_text_view_add_post_filter_rule_bottom_sheet_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="8dp"
            android:textSize="?attr/font_12"
            android:textColor="?attr/secondaryTextColor"
            android:fontFamily="?attr/font_family" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/value_text_input_layout_add_post_filter_rule_bottom_sheet_fragment"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/value_text_input_edit_text_add_post_filter_rule_bottom_sheet_fragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="3"
                    android:textSize="?attr/font_default"
                    android:fontFamily="?attr/font_family" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageView
                android:id="@+id/pick_image_view_add_post_filter_rule_bottom_sheet_fragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:padding="8dp"
                android:background="?attr/actionBarItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/content_description_post_filter_add_subreddit_user" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/cancel_text_view_add_post_filter_rule_bottom_sheet_fragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/cancel"
                android:textSize="?attr/font_default"
                android:fontFamily="?attr/font_family"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/save_text_view_add_post_filter_rule_bottom_sheet_fragment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:text="@string/ok"
                android:textSize="?attr/font_default"
                android:fontFamily="?attr/font_family"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
