<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Aspect-ratio view, not a plain ImageView: a row with no intrinsic height measures to
             nothing until Glide delivers a drawable, and a failed load then leaves a 0px row. -->
        <ml.docilealligator.infinityforreddit.customviews.AspectRatioGifImageView
            android:id="@+id/image_view_item_gallery_list_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- A gif's or video's clip, laid over its still while the row plays it. The shutter is clear,
             so the still shows until the first frame instead of a black flash. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view_item_gallery_list_entry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:use_controller="false"
            app:surface_type="texture_view"
            app:resize_mode="fit"
            app:shutter_background_color="@android:color/transparent" />

        <ImageView
            android:id="@+id/play_badge_image_view_item_gallery_list_entry"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_play_circle_36dp"
            android:visibility="gone"
            android:contentDescription="@null"
            app:tint="@android:color/white" />

        <!-- The picture's place in the gallery, small in the top left corner. -->
        <TextView
            android:id="@+id/index_text_view_item_gallery_list_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_gallery_item_number"
            android:fontFamily="?attr/font_family"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="#B8F7FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/error_image_view_item_gallery_list_entry"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_error_outline_white_24dp"
            android:visibility="gone"
            android:contentDescription="@null"
            app:tint="@android:color/white" />

    </FrameLayout>

    <TextView
        android:id="@+id/caption_text_view_item_gallery_list_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:fontFamily="?attr/font_family"
        android:textColor="@android:color/white"
        android:textSize="?attr/font_default"
        android:visibility="gone" />

</LinearLayout>
