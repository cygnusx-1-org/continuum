<?xml version="1.0" encoding="utf-8"?>
<!-- A gallery tile's player, laid over the tile's picture while its video plays. Bare: the tile
     stays a tile, so a tap opens the post as it always has. The shutter is clear, so the picture
     shows through until the first frame instead of a black flash. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_item_post_gallery_video_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/transparent" />

    <ImageView
        android:id="@+id/error_loading_video_image_view_item_post_gallery_video_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="center"
        android:background="@drawable/play_button_round_background"
        android:src="@drawable/ic_error_white_36dp"
        android:visibility="gone" />

</FrameLayout>
